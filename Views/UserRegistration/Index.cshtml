@model SIMS_dotNet.Models.Users;
@{
    Layout = "_LoginLayout";

}

<div class="login-background">
    <div style="display:flex;">
        <form class="login-form" asp-controller="UserRegistration" asp-action="Create" method="post">
            <img src="~/img/Lock.webp" alt="lock, Login" class="login-icon" />

            <div class="login-field">
                <label for=" username">User:</label>
                <input asp-for="Username" type="text" placeholder="Username" name="username" class="login-input" required>
            </div>

            <div class="login-field">
                <label for="password">Password:</label>
                <input asp-for="Password" type="password" placeholder="Password" name="password" class="login-input" required>
            </div>

            <div class="login-field">
                <label for="phoneNumber">Phone number:</label>
                <input asp-for="PhoneNumber" type="tel" placeholder="Phone number" name="phoneNumber" class="login-input" required />
            </div>

            <div class="login-field">
                <label for="role">Admin privilegies:</label>
                <select asp-for="Role" type="checkbox" name="userRole" class="login-input" required >
                    <option value="0"> Admin</option>
                    <option value="1"> Editor</option>
                    <option value="2"> Manager</option>
                    <option value="3"> Sales</option>
                </select>
            </div>

            <div class="login-field">
                <label for="firstName">Name:</label>
                <input asp-for="FirstName" type="text" placeholder="First name" name="firstName" class="login-input" required />
            </div>

            <div class="login-field">
                <label for="lastName">Last name:</label>
                <input asp-for="LastName" type="text" placeholder="Last name" name="lastName" class="login-input" required />
            </div>

            <div class="login-field">
                <label for="warehouse">Assigned warehouse:</label>
                <select asp-for="AssignedWarehouse" "type=" text" placeholder="Warehouse" name="AssignedWarehouse" class="login-input" required>
                    <option value="0">Matriz</option>
                    <option value="1">Paseo Del Toro</option>
                    <option value="2">Piedras Negras</option>
                    <option value="3">Alvarado</option>
                    <option value="4">Monterrey</option>
                </select>
            </div>

            <div class="login-field">
                <label for="birthDay">Birth day:</label>
                <input asp-for="BirthDate" type="date" placeholder="Birth day" name="birthDay" class="login-input" required />
            </div>

            <button type="submit" class="login-button">Login</button>

        </form>
    </div>
</div>

<style>
    .login-background {
        height: 100vh;
        width: 100vw;
        background-image: url('img/background.jpg');
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
        display: flex;
        align-content: center;
        flex-direction: row;
        flex-wrap: nowrap;
        justify-content: center;
    }

    .login-form {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .login-icon {
        width: 25%;
        margin: 0 0 50px 0;
    }

    .login-field {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 2%;
        width: 50%;
    }

        .login-field label {
            display: flex;
            width: 50%;
            margin-right: 10px;
            color: white;
            font-weight: bold;
            min-width: 100px; /* asegura que queden alineados */
            text-align: center;
        }

    .login-input {
        width: 40%;
        background-color: transparent;
        color: lightgray;
        border: 1.5px solid white;
        border-radius: 5px;
    }

        .login-input::placeholder {
            color: lightgray;
            text-align: center;
        }

        .login-input:focus {
            outline: none;
            box-shadow: none;
        }

    .login-button {
        width: 40%;
        color: midnightblue;
        background-color: rgba(255, 255, 255, 255);
        border: 1.5px solid white;
        border-radius: 5px;
    }
</style>